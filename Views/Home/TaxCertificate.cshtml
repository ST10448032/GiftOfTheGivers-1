@model GiftOfTheGivers.Models.Donation

@{
    ViewData["Title"] = "Donation Tax Certificate";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow border-0">

                <div class="card-body p-5">

                    <div class="text-center">

                        <h1 class="fw-bold">
                            Gift of the Givers
                        </h1> 

                        <h2 class="mt-3">
                            Donation Tax Certificate
                        </h2>

                        <p class="text-muted">
                            Disaster Relief and Humanitarian Support
                        </p>

                    </div>

                    <hr class="my-4" />

                    <div class="alert alert-success text-center">

                        <h4 class="fw-bold">
                            Donation Successful!
                        </h4>

                        <p class="mb-0">
                            Thank you for supporting humanitarian
                            and disaster-relief initiatives.
                        </p>

                    </div>

                    <h5 class="fw-bold mt-4 mb-3">
                        Donation Details
                    </h5>

                    <dl class="row">

                        <dt class="col-sm-5">
                            Donor Name
                        </dt>

                        <dd class="col-sm-7">
                            @(ViewBag.DonorName ?? "Anonymous Donor")
                        </dd>

                        <dt class="col-sm-5">
                            Email
                        </dt>

                        <dd class="col-sm-7">
                            @(ViewBag.DonorEmail ?? "Not provided")
                        </dd>

                        <dt class="col-sm-5">
                            Donation Amount
                        </dt>

                        <dd class="col-sm-7 fw-bold">
                            @Model.Currency
                            @Model.Amount.ToString("N2")
                        </dd>

                        <dt class="col-sm-5">
                            Donation Type
                        </dt>

                        <dd class="col-sm-7">
                            @Model.DonationType
                        </dd>

                        <dt class="col-sm-5">
                            Donation Date
                        </dt>

                        <dd class="col-sm-7">
                            @Model.DonationDate.ToString("dd MMMM yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-5">
                            Reference Number
                        </dt>

                        <dd class="col-sm-7 fw-bold">
                            @Model.ReferenceNumber
                        </dd>

                        <dt class="col-sm-5">
                            Anonymous Donation
                        </dt>

                        <dd class="col-sm-7">
                            @(Model.IsAnonymous ? "Yes" : "No")
                        </dd>

                    </dl>

                    <hr class="my-4" />

                    <div class="text-center">

                        <p class="text-muted">
                            This tax certificate is generated
                            for demonstration purposes.
                        </p>

                        <button onclick="window.print()"
                                class="btn btn-dark me-2">
                            Download / Print Certificate
                        </button>

                        <a asp-controller="Donation"
                           asp-action="MyDonations"
                           class="btn btn-warning">
                            My Donations
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>